# Aegis Research OS - Environment Configuration
# Copy to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis_research
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
# Default backend: DeepSeek (OpenAI-compatible)
# DEEPSEEK_API_KEY=
# Alternate backend: Grok (xAI); model override via GROK_MODEL (default grok-4)
# GROK_API_KEY=
ANTHROPIC_API_KEY=sk-ant-xxxxx
# LLM_MODE: "mock" (no API key needed) or "live" (requires valid API key)
LLM_MODE=mock

# --- Data Sources ---
# SEC EDGAR (free, no key needed but requires User-Agent)
SEC_USER_AGENT="Aegis Research OS research@example.com"
# Legacy alias still supported by some older call sites:
# EDGAR_USER_AGENT="Aegis Research OS research@example.com"

# Optional market / macro enrichment
# FMP_API_KEY=
# FRED_API_KEY=

# Bloomberg (optional)
# BLOOMBERG_API_KEY=

# Wind (optional, for China A-share data)
# WIND_API_KEY=

# --- Storage ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aegis-documents

# --- Security ---
SECRET_KEY=change-me-in-production
